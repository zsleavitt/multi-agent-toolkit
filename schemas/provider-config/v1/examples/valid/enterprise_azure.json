{
  "schema_version": "1.0.0",
  "providers": {
    "azure-prod": {
      "type": "azure",
      "auth_env": "AZURE_OPENAI_API_KEY",
      "api_base": "https://mycompany.openai.azure.com/",
      "default_headers": {
        "x-ms-deployment-name": "gpt-4-turbo"
      },
      "rate_limit": {
        "requests_per_minute": 100,
        "tokens_per_minute": 80000
      }
    },
    "bedrock-fallback": {
      "type": "bedrock",
      "auth_env": "AWS_ACCESS_KEY_ID",
      "enabled": true
    }
  },
  "model_aliases": {
    "orchestrator": {
      "provider": "azure-prod",
      "model": "gpt-4-turbo-2024-04-09",
      "max_tokens": 4096,
      "fallback": [
        { "provider": "bedrock-fallback", "model": "anthropic.claude-3-sonnet-20240229-v1:0" }
      ]
    },
    "worker": {
      "provider": "azure-prod",
      "model": "gpt-4-turbo-2024-04-09",
      "temperature": 0.1
    }
  },
  "defaults": {
    "timeout_ms": 60000,
    "max_retries": 2
  },
  "budgets": {
    "daily_cost_limit_cents": 10000
  }
}
