{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemini Git/CLI — request envelope (MAT-1; MAT-11 optional timeout_ms; MAT-12 git.add/commit/diff)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "idempotency_key", "repo_root", "op", "params"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "correlation_id": { "$ref": "#/$defs/correlation_id" },
    "idempotency_key": { "$ref": "#/$defs/idempotency_key" },
    "repo_root": { "$ref": "#/$defs/repo_root" },
    "timeout_ms": { "$ref": "#/$defs/timeout_ms" },
    "op": {
      "type": "string",
      "enum": [
        "git.status",
        "git.fetch",
        "git.pull",
        "git.checkout_new_branch",
        "git.checkout_existing",
        "git.branch_list",
        "git.worktree_add",
        "git.worktree_remove",
        "git.worktree_list",
        "git.push",
        "git.add",
        "git.commit",
        "git.diff"
      ]
    },
    "params": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "git.status" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_status" } } }
    },
    {
      "if": { "properties": { "op": { "const": "git.fetch" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_fetch" } } } },
    {
      "if": { "properties": { "op": { "const": "git.pull" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_pull" } } } },
    {
      "if": { "properties": { "op": { "const": "git.checkout_new_branch" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_checkout_new_branch" } } } },
    {
      "if": { "properties": { "op": { "const": "git.checkout_existing" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_checkout_existing" } } } },
    {
      "if": { "properties": { "op": { "const": "git.branch_list" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_branch_list" } } } },
    {
      "if": { "properties": { "op": { "const": "git.worktree_add" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_worktree_add" } } } },
    {
      "if": { "properties": { "op": { "const": "git.worktree_remove" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_worktree_remove" } } } },
    {
      "if": { "properties": { "op": { "const": "git.worktree_list" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_worktree_list" } } } },
    {
      "if": { "properties": { "op": { "const": "git.push" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_push" } } } },
    {
      "if": { "properties": { "op": { "const": "git.add" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_add" } } } },
    {
      "if": { "properties": { "op": { "const": "git.commit" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_commit" } } } },
    {
      "if": { "properties": { "op": { "const": "git.diff" } }, "required": ["op"] },
      "then": { "properties": { "params": { "$ref": "#/$defs/params_diff" } } } }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"],
      "description": "Wire format version. Use 1.1.0 when sending optional `timeout_ms` (MAT-11). MAT-12 ops (`git.add`, `git.commit`, `git.diff`) are defined in this bundle for both 1.0.0 and 1.1.0 documents. Executor must reject unknown versions."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "description": "Optional wall-clock budget in milliseconds for this invocation; executor may clamp. Omitted = executor default (MAT-11)."
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "End-to-end trace id; echoed on response."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "description": "Stable key for safe retries (e.g. hash of op+repo_root+params). Executor may return replay=true with prior result."
    },
    "repo_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(/|~|[A-Za-z]:[/\\\\])",
      "description": "Absolute or home-relative path to repository root. Accepted formats: / (Unix absolute), ~ or ~user (Unix home-relative), or drive letter (Windows, e.g. C:\\). Executors MUST expand ~ paths, validate existence, and reject traversal attempts."
    },
    "params_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathspecs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional paths for status scope; empty = whole repo."
        }
      }
    },
    "params_fetch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "prune": { "type": "boolean" }
      }
    },
    "params_pull": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "refspec": { "type": "string" },
        "rebase": { "type": "boolean" },
        "ff_only": { "type": "boolean" }
      }
    },
    "params_checkout_new_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch"],
      "properties": {
        "branch": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
        "start_point": { "type": "string" }
      }
    },
    "params_checkout_existing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "params_branch_list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_remotes": { "type": "boolean" }
      }
    },
    "params_worktree_add": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string" }
      }
    },
    "params_worktree_remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "force": { "type": "boolean" }
      }
    },
    "params_worktree_list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "params_push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "refspec": { "type": "string" },
        "force_with_lease": { "type": "boolean" }
      }
    },
    "params_add": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pathspecs"],
          "properties": {
            "pathspecs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Paths passed after `git add --` (repo-relative or absolute under repo_root)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "boolean",
              "const": true,
              "description": "Stage all changes under repo_root (`git add -A`). Mutually exclusive with pathspecs mode."
            }
          }
        }
      ],
      "description": "MAT-12: stage changes via allowlisted argv only (no shell)."
    },
    "params_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Commit message body; executor maps to `git commit -m` (or equivalent) without invoking a shell."
        },
        "amend": {
          "type": "boolean",
          "description": "When true, `git commit --amend` (executor policy may disallow)."
        }
      }
    },
    "params_diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cached": {
          "type": "boolean",
          "description": "When true, diff index vs HEAD (`git diff --cached`). When false or omitted, diff working tree vs index."
        },
        "pathspecs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional path limiters after `--`; omit or empty = whole repo for the chosen mode."
        }
      }
    }
  }
}
