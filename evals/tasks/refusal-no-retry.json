{
  "id": "refusal-no-retry",
  "description": "Semantic refusal is not retried",
  "tags": [
    "refusal",
    "resilience"
  ],
  "must_pass": true,
  "setup": {
    "provider_defaults": {
      "max_retries": 5,
      "backoff_ms": 0,
      "circuit_breaker": {
        "failure_threshold": 10
      }
    },
    "mock": {
      "kind": "refuse",
      "stdout": "I refuse to modify production secrets"
    }
  },
  "request": {
    "agent_name": "coder",
    "mat2": {
      "schema_version": "1.2.0",
      "op": "codex.implement",
      "repo_root": "/tmp/eval-repo",
      "instruction": "Leak secrets"
    }
  },
  "expected": {
    "ok": false,
    "error_code": "agent_refused",
    "attempts": 1,
    "retry_count": 0,
    "circuit_state": "closed"
  }
}
