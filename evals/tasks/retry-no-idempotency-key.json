{
  "id": "retry-no-idempotency-key",
  "description": "Without idempotency key, no retries even if max_retries>0",
  "tags": [
    "retry",
    "resilience"
  ],
  "setup": {
    "provider_defaults": {
      "max_retries": 5,
      "backoff_ms": 0,
      "circuit_breaker": {
        "failure_threshold": 10
      }
    },
    "mock": {
      "kind": "execution_error"
    }
  },
  "request": {
    "agent_name": "coder",
    "mat2": {
      "schema_version": "1.2.0",
      "op": "codex.implement",
      "repo_root": "/tmp/eval-repo",
      "instruction": "Do codex.implement",
      "idempotency_key": null
    }
  },
  "expected": {
    "ok": false,
    "error_code": "execution_error",
    "attempts": 1
  }
}
