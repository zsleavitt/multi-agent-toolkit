{
  "id": "retry-exhausted-stays-failed",
  "description": "Retries exhausted leaves execution_error",
  "tags": [
    "retry",
    "resilience"
  ],
  "setup": {
    "provider_defaults": {
      "max_retries": 2,
      "backoff_ms": 0,
      "circuit_breaker": {
        "failure_threshold": 10
      }
    },
    "mock": {
      "kind": "execution_error"
    }
  },
  "request": {
    "agent_name": "coder",
    "mat2": {
      "schema_version": "1.2.0",
      "op": "codex.implement",
      "repo_root": "/tmp/eval-repo",
      "instruction": "Do codex.implement"
    }
  },
  "expected": {
    "ok": false,
    "error_code": "execution_error",
    "attempts": 3,
    "retry_count": 2
  }
}
