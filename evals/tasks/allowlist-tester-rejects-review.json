{
  "id": "allowlist-tester-rejects-review",
  "description": "Tester cannot handle codex.review",
  "tags": [
    "allowlist",
    "rejection"
  ],
  "setup": {
    "mock": {
      "kind": "ok"
    }
  },
  "request": {
    "agent_name": "tester",
    "mat2": {
      "schema_version": "1.2.0",
      "op": "codex.review",
      "repo_root": "/tmp/eval-repo",
