{
  "$schema": "https://developers.openai.com/schemas/codex/hooks.json",
  "hooks": [
    {
      "event": "SessionStart",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_context.py\""
      ],
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_context.py\""
      ],
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_guardrails.py\""
      ],
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "apply_patch",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_guardrails.py\""
      ],
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_guardrails.py\""
      ],
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "apply_patch",
      "command": [
        "bash",
        "-c",
        "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mat_guardrails.py\""
      ],
      "timeout": 10
    }
  ]
}
