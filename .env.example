# Multi-Agent Toolkit — environment variables
# Copy to .env and fill in your values (never commit .env)

# Notion integration (optional, for ticket tracking)
MAT_NOTION_TICKETS_URL=https://www.notion.so/your-tickets-page-id
MAT_NOTION_HUB_URL=https://www.notion.so/your-hub-page-id

# Gumloop integration (optional, for workflow automation)
GUMLOOP_API_KEY=
GUMLOOP_USER_ID=

# Schema bundle overrides (optional, defaults to config/schema-registry.json paths)
# MAT_GEMINI_GIT_OPS_V1=/path/to/schemas/gemini-git-ops/v1
# MAT_CODEX_CODE_EXEC_V1=/path/to/schemas/codex-code-exec/v1
# MAT_AI_TEAM_REPO_PROFILE_V1=/path/to/schemas/ai-team-repo-profile/v1
# MAT_ORCHESTRATOR_STATE_V1=/path/to/schemas/orchestrator-state/v1
# MAT_HITL_ASANA_APPROVAL_V1=/path/to/schemas/hitl-asana-approval/v1
